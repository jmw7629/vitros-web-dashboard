# VITROS Environment Configuration
# ================================
# All secrets are server-side only (no VITE_ prefix).
# Client-safe variables use VITE_ prefix.

# ─── Convex (required) ───
VITE_CONVEX_URL=

# ─── Supabase (required) ───
# Public anon key — safe for browser, must match RLS policies
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser or use VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI (required for OCR) ───
# Server-side only — NEVER expose to browser or use VITE_ prefix
OPENAI_API_KEY=

# ─── Convex Auth (set by init_app_project or npx convex dev) ───
# CONVEX_DEPLOY_KEY=
# AUTH_PRIVATE_KEY=
# JWT_PRIVATE_KEY=

# ─── Preview mode (set by Viktor Spaces backend) ───
# VITE_IS_PREVIEW=true
