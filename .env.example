# VITROS Environment Configuration
# All secrets are server-side only (no VITE_ prefix).
# Client-safe variables use VITE_ prefix.

# --- Convex (required) ---
VITE_CONVEX_URL=

# --- Supabase (required for inventory data) ---
# Client-side anon key (RLS-protected reads only — NEVER use for writes)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Convex actions, NOT exposed to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (required for OCR — server-side only) ---
OPENAI_API_KEY=

# --- VITROS server-authoritative role picker ---
# Scrypt hash only. Generate/set this in the Convex server environment; never
# expose the plaintext password or this hash through a VITE_* variable.
VITROS_SUPERUSER_PASSWORD_HASH=

# --- Convex Auth (set by init_app_project or npx convex dev) ---
# CONVEX_DEPLOY_KEY=
# AUTH_PRIVATE_KEY=
# JWT_PRIVATE_KEY=

# --- Preview mode (set by Viktor Spaces backend) ---
# VITE_IS_PREVIEW=true

# IMPORTANT: The previously exposed Supabase service-role credential is
# COMPROMISED and must NEVER be reused. Credential rotation is required
# before any production deployment.
